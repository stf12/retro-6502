{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chiplab · hello: build",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "Chiplab · hello: run",
      "type": "shell",
      "command": "make run",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · hello: run with bus trace",
      "type": "shell",
      "command": "make trace",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · hello: run with disassembled trace",
      "type": "shell",
      "command": "make trace-asm && code build/hello.asm-trace.txt",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · gfxtest: run",
      "type": "shell",
      "command": "make run PROG=gfxtest CYCLES=0",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · window: run",
      "type": "shell",
      "command": "make run PROG=window CYCLES=0",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · any .bin: disassembled trace…",
      "type": "shell",
      "command": "make trace-bin BIN=${input:chiplabBin} CYCLES=${input:traceCycles}",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · board: list serial ports",
      "type": "shell",
      "command": "make ports",
      "problemMatcher": []
    },
    {
      "label": "C64 · hello: build",
      "type": "shell",
      "command": "make c64",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "C64 · hello: run in VICE",
      "type": "shell",
      "command": "make c64-run",
      "problemMatcher": []
    },
    {
      "label": "Chiplab · calc: build",
      "type": "shell",
      "command": "make calc",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "C64 · calc: build",
      "type": "shell",
      "command": "make calc-c64",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "Chiplab · calc: run",
      "type": "shell",
      "command": "make calc-run",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · calc: run with bus trace",
      "type": "shell",
      "command": "make calc-trace 2> trace.txt",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Chiplab · calc: run with disassembled trace",
      "type": "shell",
      "command": "make calc-trace-asm; code build/calc.asm-trace.txt",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "C64 · calc: run in VICE",
      "type": "shell",
      "command": "make calc-c64-run",
      "problemMatcher": []
    },
    {
      "label": "C64 · sidpiano: build",
      "type": "shell",
      "command": "make sidpiano",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "C64 · sidpiano: run in VICE",
      "type": "shell",
      "command": "make sidpiano-run",
      "problemMatcher": []
    },
    {
      "label": "Apple I · hello: build",
      "type": "shell",
      "command": "make apple1",
      "problemMatcher": {
        "owner": "ca65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "Apple I · hello: run in terminal (quick check)",
      "type": "shell",
      "command": "make apple1-sim",
      "problemMatcher": []
    },
    {
      "label": "Apple I · hello: run in MAME",
      "type": "shell",
      "command": "make apple1-run",
      "problemMatcher": []
    },
    {
      "label": "Apple I · BASIC: start",
      "type": "shell",
      "command": "make basic-run",
      "problemMatcher": []
    },
    {
      "label": "Apple I · BASIC: type in a program…",
      "type": "shell",
      "command": "make basic-prog PROG=apple1/programs/${input:basicProg}",
      "problemMatcher": []
    },
    {
      "label": "Apple I · machine code: type in a program…",
      "type": "shell",
      "command": "make woz-prog ${input:wozProg}",
      "problemMatcher": []
    }    
  ],

  "inputs": [
    {
      "id": "chiplabBin",
      "type": "promptString",
      "description": "Chiplab image to trace (64 KB .bin, already built)",
      "default": "build/hello.bin"
    },
    {
      "id": "traceCycles",
      "type": "pickString",
      "description": "Stop after how many cycles?",
      "options": [
        { "label": "2,000 (a few seconds)", "value": "2000" },
        { "label": "20,000 (about 25 s)", "value": "20000" },
        { "label": "No limit (interactive programs, Ctrl-C stops)", "value": "0" }
      ],
      "default": "2000"
    },
    {
      "id": "basicProg",
      "type": "pickString",
      "description": "Programma BASIC da caricare",
      "options": ["HAMURABI.txt", "startrek.txt", "wumpus.txt", "Lunar.txt", "slots.txt", "reverse.txt", "21.TXT"]
    },
    {
      "id": "wozProg",
      "type": "pickString",
      "description": "Programma in linguaggio macchina",
      "options": [
        { "label": "Life ($2000)",       "value": "PROG=apple1/programs/life.txt RUN=2000" },
        { "label": "Microchess ($0300)", "value": "PROG=apple1/programs/microchess.txt RUN=300" }
      ]
    }    
  ]  
}
